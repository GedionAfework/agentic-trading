APP_ENV=development
APP_NAME=private-trading-ai
LOG_LEVEL=INFO

# Compose maps Postgres->5433 and Redis->6380 to avoid clashes with other local stacks
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5433/trading
REDIS_URL=redis://localhost:6380/0

# Local S3-compatible store (adobe/s3mock). Access keys are ignored by s3mock but kept for SDK shape.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=test
OBJECT_STORAGE_SECRET_KEY=test
OBJECT_STORAGE_BUCKET=private-trading
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_LOCAL_ROOT=data/objects

# Private inference — never expose :11434 publicly
OLLAMA_BASE_URL=http://localhost:11434
MAIN_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RECOVERY_SECONDS=30

# Override in every non-local environment (use >= 32 chars)
JWT_SECRET=dev-only-change-me-use-long-secret

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

SCANNER_ENABLED=true
NOTIFICATIONS_ENABLED=true

# Market data (Binance public REST — no API key for spot klines)
BINANCE_BASE_URL=https://api.binance.com
MARKET_HTTP_TIMEOUT_SECONDS=20
MARKET_DEFAULT_TIMEFRAMES=15m,1h
