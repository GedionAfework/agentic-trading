APP_ENV=development
APP_NAME=private-trading-ai
LOG_LEVEL=INFO

# Compose maps Postgres->5433 and Redis->6380 to avoid clashes with other local stacks
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5433/trading
REDIS_URL=redis://localhost:6380/0

# Local S3-compatible store (adobe/s3mock). Access keys are ignored by s3mock but kept for SDK shape.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=test
OBJECT_STORAGE_SECRET_KEY=test
OBJECT_STORAGE_BUCKET=private-trading
OBJECT_STORAGE_REGION=us-east-1

OLLAMA_BASE_URL=http://localhost:11434
MAIN_MODEL=qwen2.5:14b
EMBEDDING_MODEL=nomic-embed-text

# Override in every non-local environment
JWT_SECRET=dev-only-change-me

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

SCANNER_ENABLED=true
NOTIFICATIONS_ENABLED=true
